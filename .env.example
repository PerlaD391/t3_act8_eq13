# Firebase — copia este archivo a `.env` y llena los valores con la
# configuración web de tu proyecto (Firebase Console > Configuración del
# proyecto > Tus apps > Web). NUNCA subas el `.env` real al repositorio.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
